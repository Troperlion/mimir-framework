{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mímir MPK",
  "scopeName": "source.mimir-mpk",
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#methods" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#strings" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.mimir-mpk",
          "match": "#.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(map|list|array)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.mimir-mpk" },
            "2": { "name": "entity.name.variable.mimir-mpk" }
          }
        }
      ]
    },
    "methods": {
      "patterns": [
        {
          "name": "support.function.mimir-mpk",
          "match": "\\.(set|append)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.mimir-mpk",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.mimir-mpk",
          "match": "(?<![A-Za-z0-9_])-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mimir-mpk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mimir-mpk",
              "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})"
            }
          ]
        }
      ]
    }
  }
}
