{
  "$schema": "./conf.schema.json",
  "description": "Exemple de config pour --conf: charge une config et exécute des scripts Lua",
  
  "lua": {
    "scripts": [
      "scripts/templates/template_conf_load_and_train.lua",
      {
        "script": "scripts/examples/example_conf_inference.lua",
        "args": ["--num-samples", "10"]
      }
    ]
  },

  "model": {
    "architecture": "transformer",
    "vocab_size": 8192,
    "seq_len": 128,
    "d_model": 256,
    "num_layers": 4,
    "num_heads": 8,
    "mlp_hidden": 1024
  },

  "tokenizer": {
    "type": "bpe",
    "max_vocab": 8192,
    "max_sequence_length": 128
  },

  "training": {
    "num_epochs": 3,
    "batch_size": 8,
    "learning_rate": 0.0001,
    "optimizer": "adamw",
    "weight_decay": 0.01,
    "warmup_steps": 500
  },

  "dataset": {
    "name": "example_dataset",
    "split": "train"
  },

  "inference": {
    "temperature": 0.8,
    "top_k": 40,
    "top_p": 0.95
  }
}
