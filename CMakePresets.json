{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 15,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MIMIR_ENABLE_TESTS": "ON",
        "ENABLE_VULKAN": "OFF",
        "ENABLE_OPENCL": "OFF",
        "ENABLE_SFML": "OFF",
        "ENABLE_OPENMP": "ON",
        "ENABLE_LZ4": "ON"
      }
    },
    {
      "name": "colab-cuda",
      "displayName": "Google Colab GPU (headless)",
      "description": "Release headless avec auto-détection CUDA/ROCm pour Google Colab",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-colab",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MIMIR_ENABLE_TESTS": "OFF",
        "MIMIR_PORTABLE_BUILD": "ON",
        "MIMIR_VIZ_BACKEND": "NONE",
        "ENABLE_SIMD": "ON",
        "ENABLE_OPENMP": "ON",
        "ENABLE_VULKAN": "OFF",
        "ENABLE_OPENCL": "OFF",
        "MIMIR_AUTO_DETECT_GPU_BACKENDS": "ON",
        "ENABLE_CUDA": "OFF",
        "ENABLE_ROCM": "OFF",
        "ENABLE_FFMPEG": "ON",
        "ENABLE_SFML": "OFF",
        "ENABLE_LZ4": "ON",
        "ENABLE_SCRIPTING_REST": "OFF",
        "ENABLE_SCRIPTING_RUST": "OFF",
        "ENABLE_SCRIPTING_JS": "OFF",
        "ENABLE_SCRIPTING_CSHARP": "OFF",
        "BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "windows-cross-base",
      "displayName": "Windows Cross (MinGW + vcpkg)",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_win_cross",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++",
        "CMAKE_RC_COMPILER": "x86_64-w64-mingw32-windres",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic",
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_VULKAN": "OFF",
        "ENABLE_OPENCL": "OFF",
        "ENABLE_SFML": "OFF",
        "ENABLE_FFMPEG": "OFF",
        "ENABLE_OPENMP": "ON",
        "ENABLE_LZ4": "ON"
      }
    },
    {
      "name": "windows-cross",
      "displayName": "Windows Cross Release",
      "inherits": "windows-cross-base",
      "binaryDir": "${sourceDir}/build_win_cross_omp_noapplocal",
      "cacheVariables": {
        "MIMIR_ENABLE_TESTS": "OFF"
      }
    },
    {
      "name": "windows-cross-tests",
      "displayName": "Windows Cross Release + Tests",
      "inherits": "windows-cross-base",
      "binaryDir": "${sourceDir}/build_win_cross_tests",
      "cacheVariables": {
        "MIMIR_ENABLE_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "build-colab-cuda",
      "configurePreset": "colab-cuda",
      "targets": [
        "mimir"
      ],
      "jobs": 2
    },
    {
      "name": "build-windows-cross",
      "configurePreset": "windows-cross"
    },
    {
      "name": "build-windows-cross-tests",
      "configurePreset": "windows-cross-tests"
    }
  ]
}
