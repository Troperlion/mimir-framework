#version 450
float norm_join(float a,float b){float hi=max(abs(a),abs(b)),lo=min(abs(a),abs(b));if(hi==0.0)return 0.0;float q=lo/hi;return hi*sqrt(1.0+q*q);}
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) buffer Data {float memory[];};
layout(set=0,binding=1,std430) readonly buffer Params {int args[];};
shared float sumsA[256],sumsB[256];
#define F(k) intBitsToFloat(args[3+(k)])
#define BARRIER barrier()
void main(){int i=int(gl_GlobalInvocationID.x),local=int(gl_LocalInvocationID.x),group=int(gl_WorkGroupID.x);

int n=args[1],kind=args[2],pass=args[0],groups=(n+255)/256;
if(pass==0 && i<n) {
 float w=memory[i],g=memory[n+i],m=memory[2*n+i],v=memory[3*n+i],u=g;
 float b1=F(1),b2=F(2),eps=F(3),wd=F(4),bc1=F(5),bc2=F(6);
 if(kind==1 || kind==2 || kind==5 || kind==6 || kind==8) {
  m=b1*m+(1.0-b1)*g;v=b2*v+(1.0-b2)*g*g;
  float mh=m/bc1,vh=v/bc2;
  u=mh/(sqrt(vh)+eps);
  if(kind==5)u=F(14)>5.0?F(13)*mh/(sqrt(vh)+eps):mh;
  if(kind==6)u=(b1*mh+(1.0-b1)*g/bc1)/(sqrt(vh)+eps);
  if(kind==8)u+=wd*w;
 } else if(kind==3) {
  float update=b1*m+(1.0-b1)*g;
  u=float(update>0.0)-float(update<0.0)+wd*w;
  m=b2*m+(1.0-b2)*g;
 } else if(kind==4) {
  v=F(7)*v+(1.0-F(7))*g*g;u=g/sqrt(v+max(1e-30,eps));
 } else if(kind==7) {
  v=F(15)*v+(1.0-F(15))*g*g;u=g/(sqrt(v)+eps);
 }
 memory[2*n+i]=m;memory[3*n+i]=v;memory[4*n+i]=u;
 if(kind!=4 && kind!=8)memory[i]=kind==2?w-F(0)*u-F(0)*(F(4)*w):w-F(0)*u;
}
if(pass==1 || pass==3) {
 float a=0.0,b=0.0;
 if(pass==1){if(i<n){float u=memory[4*n+i],w=memory[i];a=abs(u)/sqrt(float(n));b=abs(w)/sqrt(float(n));}}
 else {for(int j=local;j<groups;j+=256){a=norm_join(a,memory[5*n+2*j]);b=norm_join(b,memory[5*n+2*j+1]);}}
 sumsA[local]=a;sumsB[local]=b;BARRIER;
 for(int stride=128;stride>0;stride/=2){if(local<stride){sumsA[local]=norm_join(sumsA[local],sumsA[local+stride]);sumsB[local]=norm_join(sumsB[local],sumsB[local+stride]);}BARRIER;}
 if(local==0){int at=5*n+2*(pass==1?group:groups);memory[at]=sumsA[0];memory[at+1]=sumsB[0];}
}
if(pass==2 && i<n) {
 float w=memory[i],u=memory[4*n+i],lr=F(0);
 if(kind==4) {
  float rms=memory[5*n+2*groups];float clip=1.0/max(1.0,rms/F(9));
  float scale=F(12)>0.0?max(F(10),memory[5*n+2*groups+1]):1.0;
  u=clip*memory[n+i]/sqrt(memory[3*n+i]+max(1e-30,F(3)));
  if(F(8)>0.0){float m=F(8)*memory[2*n+i]+(1.0-F(8))*u;memory[2*n+i]=m;u=m;}
  w-=F(11)*scale*u;
 } else if(kind==8) {
  float wn=memory[5*n+2*groups+1]*sqrt(float(n)),un=memory[5*n+2*groups]*sqrt(float(n));float ratio=wn>0.0 && un>0.0?wn/un:1.0;
  w-=lr*ratio*u;
 } else if(kind==2)w=w-lr*u-lr*(F(4)*w);
 else w-=lr*u;
 memory[i]=w;
}

}
